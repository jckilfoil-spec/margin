# Copy this file to .env and fill in the values.
# .env is git-ignored. This file (.env.example) is committed as documentation.
# NEVER commit .env or paste real keys into code.

# Supabase
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=

# Analytics (PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Add more keys here as the project grows.
# Prefix every client-side variable with VITE_ (Vite only inlines VITE_* vars).
# Server-side / secret keys (service_role, Stripe secret, etc.) go in a
# separate .env.server file that is also git-ignored and never shared.
