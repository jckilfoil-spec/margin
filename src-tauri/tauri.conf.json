{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "margin",
  "version": "0.0.1",
  "identifier": "app.margin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "margin",
        "width": 1100,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Paper-feel notepad with chunky checkboxes.",
    "longDescription": "margin is a single-user, local-only daily notepad. Plain Markdown files in a folder you choose. Chunky 24x24 checkboxes whose check marks intentionally extend past the box.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
